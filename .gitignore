# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
wheels/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.pyre/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# MailProof local artifacts (root only — do NOT ignore mailproof/report.py)
/demo.zone
/report.*
/*.sarif
!.github/workflows/*.yml

# Secrets & local config — never commit these
.env
.env.*
*.pem
*.key
secrets/

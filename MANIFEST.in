include LICENSE
include README.md README.zh-TW.md README.en.md
include CONTRIBUTING.md CHANGELOG.md
include pyproject.toml requirements.txt requirements-dev.txt
include Makefile .editorconfig .gitignore
recursive-include docs *.md
recursive-include examples *.zone *.json *.yml
recursive-include scripts *.py
recursive-include tests *.py
recursive-include .github/workflows *.yml
global-exclude __pycache__ *.py[cod] *.egg-info
